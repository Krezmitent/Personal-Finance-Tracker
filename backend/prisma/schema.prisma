generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int           @id @default(autoincrement())
  email        String        @unique
  password     String
  transactions Transaction[]
  budgets      Budget[]
  investments  Investment[]
  createdAt    DateTime      @default(now())
}

model Transaction {
  id        Int      @id @default(autoincrement())
  userId    Int
  amount    Float
  category  String
  merchant  String
  date      DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([userId, date])
}

model Budget {
  id           Int      @id @default(autoincrement())
  userId       Int
  category     String
  monthlyLimit Float
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
}

model Investment {
  id        Int      @id @default(autoincrement())
  userId    Int
  assetName String
  type      String
  quantity  Float
  buyPrice  Float
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
